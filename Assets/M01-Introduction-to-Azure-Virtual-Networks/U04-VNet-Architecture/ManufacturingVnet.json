{
  "$schema": "https://schema.management.azure.com",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "Author": "DCyVer",
    "Project": "AZ-SEC-Infra-Labs",
    "Module": "04-VNet-Architecture",
    "Version": "1.0"
  },
  "parameters": {
    "vnetName": { "defaultValue": "ManufacturingVnet", "type": "string" },
    "location": { "defaultValue": "westeurope", "type": "string" }
  },
  "variables": {},
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-11-01",
      "name": "[parameters('vnetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": { "addressPrefixes": ["10.30.0.0/16"] },
        "subnets": [
          { "name": "ManufacturingSystemSubnet", "properties": { "addressPrefix": "10.30.10.0/24" } },
          { "name": "SensorSubnet1", "properties": { "addressPrefix": "10.30.20.0/24" } },
          { "name": "SensorSubnet2", "properties": { "addressPrefix": "10.30.21.0/24" } },
          { "name": "SensorSubnet3", "properties": { "addressPrefix": "10.30.22.0/24" } }
        ]
      }
    }
  ]
}
