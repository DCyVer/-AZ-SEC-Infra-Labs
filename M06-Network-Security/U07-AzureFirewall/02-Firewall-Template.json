{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "location": {
            "type": "String"
        },
        "resourceGroup": {
            "type": "String"
        },
        "azureFirewallName": {
            "type": "String"
        },
        "azureFirewallTier": {
            "type": "String"
        },
        "vnetName": {
            "type": "String"
        },
        "vnetAddressSpace": {
            "type": "String"
        },
        "vnetAddressSpaceV6": {
            "type": "String"
        },
        "subnetAddressSpace": {
            "type": "String"
        },
        "subnetAddressSpaceV6": {
            "type": "String"
        },
        "zones": {
            "type": "Array"
        },
        "subnetId": {
            "type": "String"
        },
        "managementSubnetId": {
            "type": "String"
        },
        "publicIpAddressName": {
            "type": "String"
        },
        "publicIpZones": {
            "type": "Array"
        },
        "publicIpV6AddressName": {
            "type": "String"
        }
    },
    "variables": {
        "networkApiVersion": "?api-version=2021-05-01"
    },
    "resources": [
        {
            "type": "Microsoft.Network/publicIpAddresses",
            "apiVersion": "2020-08-01",
            "name": "[parameters('publicIpAddressName')]",
            "location": "[parameters('location')]",
            "tags": {},
            "sku": {
                "name": "Standard"
            },
            "zones": "[parameters('publicIpZones')]",
            "properties": {
                "publicIPAllocationMethod": "Static",
                "publicIPAddressVersion": "IPv4"
            }
        },
        {
            "type": "Microsoft.Network/azureFirewalls",
            "apiVersion": "2020-05-01",
            "name": "[parameters('azureFirewallName')]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId(parameters('resourceGroup'), 'Microsoft.Network/publicIpAddresses', parameters('publicIpAddressName'))]"
            ],
            "tags": {},
            "zones": "[parameters('zones')]",
            "properties": {
                "ipConfigurations": [
                    {
                        "name": "[parameters('publicIpAddressName')]",
                        "properties": {
                            "subnet": {
                                "id": "[parameters('subnetId')]"
                            },
                            "publicIpAddress": {
                                "id": "[resourceId(parameters('resourceGroup'), 'Microsoft.Network/publicIPAddresses', parameters('publicIpAddressName'))]"
                            }
                        }
                    }
                ],
                "sku": {
                    "tier": "[parameters('azureFirewallTier')]"
                },
                "firewallPolicy": {
                    "id": "/subscriptions/815fb1a7-d584-44f4-ad61-72c3a8b8edbf/resourcegroups/Test-FW-RG/providers/Microsoft.Network/firewallPolicies/fw-test-pol"
                }
            }
        }
    ]
}